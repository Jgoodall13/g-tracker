{
  "name": "g-tracker",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently --names \"client,server\" --prefix-colors \"cyan,green\" \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}